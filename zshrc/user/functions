# ==============================================================================
# PERSONAL ZSH FUNCTIONS
# ==============================================================================

promptstyle() {
    local root="${XDG_CONFIG_HOME:-$HOME/.config}/starship"
    local profiles="$root/profiles"
    local active="$root/omni-os.toml"
    local name="$1"

    if [[ -z "$name" ]]; then
        print "Available Starship profiles:"

        local profile
        for profile in "$profiles"/*.toml(N); do
            print "  ${profile:t:r}"
        done

        return 0
    fi

    local profile="$profiles/$name.toml"

    if [[ ! -f "$profile" ]]; then
        print -u2 "promptstyle: profile '$name' does not exist"
        print -u2 "Run 'promptstyle' to list available profiles."
        return 1
    fi

    ln -sfn "profiles/$name.toml" "$active" || return 1

    print "Starship profile: $name"
}

# Select an image for fastfetch to display as logo
fflogo() {
    local pictures image
    local finder

    if command -v fd >/dev/null 2>&1; then
        finder="fd"
    elif command -v find >/dev/null 2>&1; then
        finder="find"
    else
        print -u2 "fflogo: neither 'fd' nor 'find' is available"
        return 1
    fi

    if [[ "$finder" == "fd" ]]; then
        pictures=$(command fd -i -t d '^pictures$' "$HOME" --max-depth 1 -a | head -n1)
    else
        pictures=$(command find "$HOME" -mindepth 1 -maxdepth 1 \
            -type d -iname 'pictures' -print -quit)
    fi

    [[ -n "$pictures" ]] || {
        print -u2 "fflogo: no Pictures directory found in \$HOME"
        return 1
    }

    if [[ "$finder" == "fd" ]]; then
        image=$(command fd -i -t f . "$pictures" \
            -e png -e jpg -e jpeg -e webp -a | fzf --prompt="Fastfetch image > ")
    else
        image=$(command find "$pictures" -type f \
            \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
            -print | fzf --prompt="Fastfetch image > ")
    fi

    [[ -n "$image" ]] || return 1

    mkdir -p "$HOME/.config"
    printf '%s\n' "$image" > "$HOME/.config/fastfetch-logo"
}
